# ONNX models used by motion/prepare/prepare.py. scripts/motion-prepare.sh downloads each one at its pinned
# Hugging Face revision and refuses it unless the sha256 matches.
# Depth Anything V2 Small (Apache-2.0), fp32 ONNX export by onnx-community: relative inverse depth.
DEPTH_MODEL_URL=https://huggingface.co/onnx-community/depth-anything-v2-small/resolve/4472b7362082ad9968fee890ca0f1e5aca36b93d/onnx/model.onnx
DEPTH_MODEL_SHA256=afb6a5c28f3b6bf1618c6e43f02073ef9dfdc70e937502d51603e57b0a1df10c
# YuNet 2023mar face detector (MIT, OpenCV Zoo), fixed 640x640 BGR input.
FACE_MODEL_URL=https://huggingface.co/opencv/face_detection_yunet/resolve/3cc26e7f1014a5ee5d74a42acee58bafc9d0a310/face_detection_yunet_2023mar.onnx
FACE_MODEL_SHA256=8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4
