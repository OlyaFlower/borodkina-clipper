{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/OlyaFlower/borodkina-clipper/blob/develop/motion/kit/scene.schema.json",
  "title": "Motion kit-2.1 scene spec",
  "description": "An 8 s seamless loop composed from kit blocks (motion/kit/API.md). The first block is the base (parallax or card-float); the others are applied in order. Generated by motion/kit/schema.mjs.",
  "type": "object",
  "required": [
    "kit",
    "blocks"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kit": {
      "const": "kit-2.1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "about": {
      "type": "string",
      "maxLength": 400
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "beats": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0.5,
        "exclusiveMaximum": 6.4
      },
      "description": "beat times in seconds (loop-safe range 0.5..6.4)"
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/definitions/entry"
      }
    }
  },
  "definitions": {
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rhythm": {
          "enum": [
            "primary",
            "reactive",
            "ambient",
            "wave"
          ],
          "description": "primary: the beats; reactive: answers them; ambient: always on; wave: one slow swell"
        },
        "delay": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "shift of the beats for this block, s"
        }
      }
    },
    "params-parallax": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "camera": {
          "enum": [
            "orbit",
            "drift",
            "tilt",
            "dolly"
          ],
          "default": "orbit",
          "description": "camera path (see loop.js cameraPath)"
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 40,
          "default": 16,
          "description": "largest shift in px between the nearest and the farthest plane"
        },
        "push": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.03,
          "default": 0.012,
          "description": "dolly only: relative scale per unit of depth at the deepest push"
        },
        "pivot": {
          "enum": [
            "subject",
            "near",
            "far"
          ],
          "default": "subject",
          "description": "which depth stays still: the subject (faces or focal point), the near plane or the far plane"
        }
      }
    },
    "params-card-float": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rise": {
          "type": "number",
          "minimum": 0,
          "maximum": 24,
          "default": 8,
          "description": "how far the card rises at the top of the float, px"
        },
        "sway": {
          "type": "number",
          "minimum": 0,
          "maximum": 24,
          "default": 6,
          "description": "sideways sway, px (one slow period per loop)"
        },
        "counter": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.4,
          "description": "the surround moves this share of the card offset the other way"
        }
      }
    },
    "params-light-sweep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.6,
          "default": 0.18,
          "description": "peak strength of the light"
        },
        "width": {
          "type": "number",
          "minimum": 0.04,
          "maximum": 0.4,
          "default": 0.16,
          "description": "band width, share of the diagonal"
        },
        "angle": {
          "type": "number",
          "minimum": -80,
          "maximum": 80,
          "default": 32,
          "description": "band direction in degrees from vertical"
        },
        "colour": {
          "type": "string",
          "anyOf": [
            {
              "enum": [
                "light",
                "dark",
                "accent",
                "c0",
                "c1",
                "c2",
                "c3",
                "c4",
                "warm",
                "paper",
                "graphite",
                "white"
              ]
            },
            {
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          ],
          "default": "light",
          "description": "light colour (palette name or #rrggbb)"
        },
        "target": {
          "enum": [
            "all",
            "card"
          ],
          "default": "all",
          "description": "the whole picture, or only the card (extend mode)"
        }
      }
    },
    "params-god-rays": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.7,
          "default": 0.22,
          "description": "peak strength"
        },
        "source": {
          "enum": [
            "light",
            "top",
            "focus"
          ],
          "default": "light",
          "description": "where the rays start: the brightest light of the cover (else the top), the top centre, or the focal point"
        },
        "reach": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 1.5,
          "default": 0.7,
          "description": "fall-off length, share of the frame height"
        },
        "rays": {
          "type": "number",
          "minimum": 4,
          "maximum": 24,
          "default": 7,
          "description": "angular frequency of the shafts"
        },
        "turn": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2,
          "default": 0.06,
          "description": "how far the fan turns and back, radians"
        },
        "colour": {
          "type": "string",
          "anyOf": [
            {
              "enum": [
                "light",
                "dark",
                "accent",
                "c0",
                "c1",
                "c2",
                "c3",
                "c4",
                "warm",
                "paper",
                "graphite",
                "white"
              ]
            },
            {
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          ],
          "default": "light"
        }
      }
    },
    "params-stage-beams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.6,
          "default": 0.2,
          "description": "peak strength of a beam"
        },
        "count": {
          "type": "number",
          "minimum": 2,
          "maximum": 4,
          "default": 3,
          "description": "number of beams"
        },
        "sway": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.35,
          "default": 0.14,
          "description": "sway, radians"
        },
        "spread": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 0.12,
          "default": 0.05,
          "description": "how fast a beam widens with distance"
        },
        "colour": {
          "type": "string",
          "anyOf": [
            {
              "enum": [
                "light",
                "dark",
                "accent",
                "c0",
                "c1",
                "c2",
                "c3",
                "c4",
                "warm",
                "paper",
                "graphite",
                "white"
              ]
            },
            {
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          ],
          "default": "accent",
          "description": "colour of the first beam; the others take light, c1 and accent"
        },
        "saturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.62,
          "description": "saturation floor of the lamps (their hue comes from the palette)"
        }
      }
    },
    "params-bloom": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.2,
          "default": 0.45,
          "description": "peak glow strength"
        },
        "floor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.35,
          "description": "share of the glow that stays between beats"
        },
        "colour": {
          "type": "string",
          "anyOf": [
            {
              "enum": [
                "light",
                "dark",
                "accent",
                "c0",
                "c1",
                "c2",
                "c3",
                "c4",
                "warm",
                "paper",
                "graphite",
                "white"
              ]
            },
            {
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          ],
          "default": "white",
          "description": "tint of the glow"
        }
      }
    },
    "params-grain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.12,
          "default": 0.04,
          "description": "grain strength"
        },
        "size": {
          "type": "number",
          "minimum": 0.6,
          "maximum": 3,
          "default": 1.2,
          "description": "grain size in px"
        },
        "onCard": {
          "type": "boolean",
          "default": false,
          "description": "extend mode: grain on the card too"
        }
      }
    },
    "params-colour-breath": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.4,
          "default": 0.12,
          "description": "how far the balance leans"
        },
        "saturation": {
          "type": "number",
          "minimum": -0.3,
          "maximum": 0.3,
          "default": 0.08,
          "description": "saturation change at the peak"
        },
        "colour": {
          "type": "string",
          "anyOf": [
            {
              "enum": [
                "light",
                "dark",
                "accent",
                "c0",
                "c1",
                "c2",
                "c3",
                "c4",
                "warm",
                "paper",
                "graphite",
                "white"
              ]
            },
            {
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          ],
          "default": "accent",
          "description": "the colour it leans towards"
        }
      }
    },
    "params-vignette": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5,
          "default": 0.16,
          "description": "darkening of the corners"
        },
        "breath": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.3,
          "description": "share of the amount that breathes in and out"
        },
        "follow": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.35,
          "description": "how far the centre leans towards the focal point"
        }
      }
    },
    "params-pencil": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.8,
          "description": "opacity of the lines"
        },
        "ink": {
          "enum": [
            "auto",
            "graphite",
            "chalk"
          ],
          "default": "auto",
          "description": "graphite on light covers, chalk on dark ones (auto)"
        },
        "weight": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 2.5,
          "default": 1,
          "description": "line weight (about 1.5 px contours at 1)"
        },
        "hatch": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.7,
          "description": "how much hatching the shadows get"
        },
        "wash": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.7,
          "description": "how far the picture turns into paper behind the drawing"
        },
        "start": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 2.5,
          "default": 0.4,
          "description": "when drawing starts, s"
        },
        "drawFor": {
          "type": "number",
          "minimum": 1,
          "maximum": 4,
          "default": 2.6,
          "description": "how long drawing takes, s"
        },
        "liftAt": {
          "type": "number",
          "minimum": 4,
          "maximum": 6.6,
          "default": 5,
          "description": "when the colour starts to flood back and the lines lift (all gone by 7.5 s), s"
        },
        "boil": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.5,
          "default": 0.6,
          "description": "redraw wobble, px (12 phases per second)"
        }
      }
    },
    "params-light-pulse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.6,
          "default": 0.18,
          "description": "exposure lift at the peak"
        },
        "radius": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 1.2,
          "default": 0.45,
          "description": "size of the lit area, share of the frame height"
        },
        "source": {
          "enum": [
            "focus",
            "light",
            "key"
          ],
          "default": "focus",
          "description": "centre: the focal point, the brightest light, or the key-lit side of the main face"
        },
        "breaths": {
          "type": "number",
          "minimum": 0,
          "maximum": 3,
          "default": 0,
          "description": "whole slow swells per loop (rounded; 0: follow the rhythm only); use with rhythm ambient"
        },
        "colour": {
          "type": "string",
          "anyOf": [
            {
              "enum": [
                "light",
                "dark",
                "accent",
                "c0",
                "c1",
                "c2",
                "c3",
                "c4",
                "warm",
                "paper",
                "graphite",
                "white"
              ]
            },
            {
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          ],
          "default": "warm"
        }
      }
    },
    "params-particles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dust": {
          "type": "number",
          "minimum": 0,
          "maximum": 200,
          "default": 60,
          "description": "number of dust motes"
        },
        "bokeh": {
          "type": "number",
          "minimum": 0,
          "maximum": 16,
          "default": 8,
          "description": "number of bokeh discs"
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.5,
          "default": 1,
          "description": "overall opacity"
        },
        "drift": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 1,
          "description": "how far motes wander"
        },
        "colour": {
          "type": "string",
          "anyOf": [
            {
              "enum": [
                "light",
                "dark",
                "accent",
                "c0",
                "c1",
                "c2",
                "c3",
                "c4",
                "warm",
                "paper",
                "graphite",
                "white"
              ]
            },
            {
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          ],
          "default": "light",
          "description": "colour of the motes; bokeh take the palette"
        },
        "region": {
          "enum": [
            "all",
            "upper",
            "lower"
          ],
          "default": "all",
          "description": "where the motes float"
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "block"
      ],
      "additionalProperties": false,
      "properties": {
        "block": {
          "anyOf": [
            {
              "enum": [
                "parallax",
                "card-float",
                "light-sweep",
                "god-rays",
                "stage-beams",
                "bloom",
                "grain",
                "colour-breath",
                "vignette",
                "pencil",
                "light-pulse",
                "particles"
              ]
            },
            {
              "type": "string",
              "pattern": "^custom\\/[a-z][a-z0-9-]{0,39}$"
            }
          ],
          "description": "a kit block, or custom/<name> for blocks/<name>.js next to the spec"
        },
        "preset": {
          "enum": [
            "subtle",
            "medium"
          ],
          "description": "intensity preset of the block (default subtle)"
        },
        "params": {
          "type": "object",
          "description": "overrides of the preset"
        },
        "timing": {
          "$ref": "#/definitions/timing"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "block": {
                "const": "parallax"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/definitions/params-parallax"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "block": {
                "const": "card-float"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/definitions/params-card-float"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "block": {
                "const": "light-sweep"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/definitions/params-light-sweep"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "block": {
                "const": "god-rays"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/definitions/params-god-rays"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "block": {
                "const": "stage-beams"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/definitions/params-stage-beams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "block": {
                "const": "bloom"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/definitions/params-bloom"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "block": {
                "const": "grain"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/definitions/params-grain"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "block": {
                "const": "colour-breath"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/definitions/params-colour-breath"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "block": {
                "const": "vignette"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/definitions/params-vignette"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "block": {
                "const": "pencil"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/definitions/params-pencil"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "block": {
                "const": "light-pulse"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/definitions/params-light-pulse"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "block": {
                "const": "particles"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/definitions/params-particles"
              }
            }
          }
        }
      ]
    }
  },
  "$comment": "cameras: orbit, drift, tilt, dolly"
}
